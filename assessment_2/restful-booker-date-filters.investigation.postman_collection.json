        {
          "id": "4235462a-e4c1-46aa-8f69-ab74bcea196c",
          "name": "Retrieve investigation booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  function block(message) {",
                  "    pm.test('Safety prerequisite: use only the booking created in this iteration', function () {",
                  "      throw new Error(message);",
                  "    });",
                  "    pm.execution.skipRequest();",
                  "  }",
                  "  const id = Number(pm.collectionVariables.get('ownedBookingId'));",
                  "  if (!Number.isInteger(id) || id <= 0 ||",
                  "      String(pm.collectionVariables.get('ownedIteration')) !== String(pm.info.iteration) ||",
                  "      !pm.collectionVariables.get('runMarker') ||",
                  "      pm.collectionVariables.get('ownedRunMarker') !== pm.collectionVariables.get('runMarker') ||",
                  "      String(pm.collectionVariables.get('bookingId')) !== String(id)) {",
                  "    block('No trusted Create Booking response exists for this iteration. Refusing a booking-ID request.');",
                  "    return;",
                  "  }",
                  "  // Local scope wins over stale environment or iteration-data bookingId values.",
                  "  pm.variables.set('bookingId', String(id));",
                  "  if (!['PUT', 'PATCH', 'DELETE'].includes(pm.request.method)) return;",
                  "  let expected;",
                  "  try { expected = JSON.parse(pm.collectionVariables.get('expectedBooking')); }",
                  "  catch (error) { block('Missing independent expectedBooking: ' + error.message); return; }",
                  "  // Fail closed if a reset, concurrent edit, or ID reuse changed the record.",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/booking/' + id,",
                  "    method: 'GET', header: { Accept: 'application/json' }",
                  "  }, function (error, response) {",
                  "    try {",
                  "      if (error) throw error;",
                  "      pm.expect(response.code, 'Ownership check GET status').to.equal(200);",
                  "      pm.expect(response.json(), 'Record must still equal our saved state').to.deep.equal(expected);",
                  "      pm.test('Safety: mutation targets the unchanged booking created in this iteration', function () {",
                  "        pm.expect(response.code).to.equal(200);",
                  "      });",
                  "    } catch (error) { block('Refusing mutation: ' + error.message); }",
                  "  });",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retrieval returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Retrieved booking equals saved expectedBooking', function () {",
                  "  pm.expect(pm.response.json()).to.deep.equal(JSON.parse(pm.collectionVariables.get('expectedBooking')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": [],
          "protocolProfileBehavior": {
            "disableCookies": true
          }
        }
      ]
    },
