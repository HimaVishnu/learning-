          "id": "8a238b20-922b-48a7-8de9-0436edd8b453",
          "name": "Health",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const keys = [\"token\",\"bookingId\",\"ownedBookingId\",\"ownedIteration\",\"runMarker\",\"ownedRunMarker\",\"submittedBooking\",\"expectedBooking\",\"bookingFirstName\",\"bookingLastName\",\"bookingCheckin\",\"bookingCheckout\"];",
                  "if (pm.collectionVariables.get('ownedBookingId')) {",
                  "  pm.test('Previous iteration completed cleanup', function () { throw new Error('An owned booking remains; investigate the previous cleanup before creating another.'); });",
                  "  pm.execution.skipRequest();",
                  "  pm.execution.setNextRequest(null);",
                  "} else {",
                  "  keys.forEach(function (key) { pm.collectionVariables.set(key, ''); pm.variables.unset(key); });",
                  "  pm.collectionVariables.set('runMarker', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
