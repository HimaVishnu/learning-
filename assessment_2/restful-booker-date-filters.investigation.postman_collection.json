    {
      "name": "03 Create and retrieve",
      "item": [
        {
          "id": "76f1098c-c961-4966-a11d-f352052b1509",
          "name": "Create Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  try {",
                  "    const data = pm.iterationData.toObject();",
                  "    ['dataFirstName', 'dataLastName', 'dataCheckin', 'dataCheckout', 'dataNeeds'].forEach(function (key) {",
                  "      pm.expect(data[key], key).to.be.a('string').and.not.empty;",
                  "    });",
                  "    pm.expect(data.dataPrice, 'dataPrice must be a JSON number').to.be.a('number');",
                  "    pm.expect(Number.isFinite(data.dataPrice) && data.dataPrice >= 0).to.equal(true);",
                  "    pm.expect(data.dataDepositPaid, 'dataDepositPaid must be a JSON boolean').to.be.a('boolean');",
                  "    [data.dataCheckin, data.dataCheckout].forEach(function (value) {",
                  "      pm.expect(value).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "      pm.expect(new Date(value).toISOString().slice(0, 10)).to.equal(value);",
                  "    });",
                  "    pm.expect(data.dataCheckin < data.dataCheckout, 'checkin precedes checkout').to.equal(true);",
                  "    const booking = {",
                  "      firstname: data.dataFirstName, lastname: data.dataLastName,",
                  "      totalprice: data.dataPrice, depositpaid: data.dataDepositPaid,",
                  "      bookingdates: { checkin: data.dataCheckin, checkout: data.dataCheckout },",
                  "      additionalneeds: data.dataNeeds",
                  "    };",
                  "    const submitted = JSON.stringify(booking);",
                  "    pm.variables.set('createBookingPayload', submitted);",
                  "    pm.collectionVariables.set('submittedBooking', submitted);",
                  "    pm.collectionVariables.set('expectedBooking', submitted);",
                  "    pm.collectionVariables.set('bookingFirstName', booking.firstname);",
                  "    pm.collectionVariables.set('bookingLastName', booking.lastname);",
                  "    pm.collectionVariables.set('bookingCheckin', booking.bookingdates.checkin);",
                  "    pm.collectionVariables.set('bookingCheckout', booking.bookingdates.checkout);",
                  "    pm.test('Iteration data has the required JSON types and valid dates', function () { pm.expect(true).to.equal(true); });",
                  "  } catch (error) {",
                  "    pm.test('Iteration data has the required JSON types and valid dates', function () { throw error; });",
                  "    pm.execution.skipRequest();",
                  "  }",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create Booking returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Capture the positive integer booking ID from this creation response', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const id = pm.response.json().bookingid;",
                  "  pm.expect(Number.isInteger(id) && id > 0).to.equal(true);",
                  "  pm.collectionVariables.set('bookingId', id);",
                  "  pm.collectionVariables.set('ownedBookingId', id);",
                  "  pm.collectionVariables.set('ownedIteration', String(pm.info.iteration));",
                  "  pm.collectionVariables.set('ownedRunMarker', pm.collectionVariables.get('runMarker'));",
                  "});",
                  "pm.test('Created booking equals the independently saved submitted iteration data', function () {",
                  "  pm.expect(pm.response.json().booking).to.deep.equal(JSON.parse(pm.collectionVariables.get('submittedBooking')));",
                  "});"
                ]
              }
            }
          ],
