      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking ID search returns HTTP 200', function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Response is an array of positive integer booking IDs', function () {\r\n    const bookings = pm.response.json();\r\n\r\n    pm.expect(bookings).to.be.an('array');\r\n\r\n    bookings.forEach(function (booking) {\r\n        pm.expect(Number.isInteger(booking.bookingid)).to.equal(true);\r\n        pm.expect(booking.bookingid).to.be.above(0);\r\n    });\r\n});\r\n\r\npm.test('Booking IDs are unique within this response', function () {\r\n    const bookings = pm.response.json();\r\n    const ids = bookings.map(function (booking) {\r\n        return booking.bookingid;\r\n    });\r\n\r\n    pm.expect(new Set(ids).size).to.equal(ids.length);\r\n});\r\n\r\npm.test('Results include the booking created by this workflow', function () {\r\n    const ownBookingId = Number(\r\n        pm.collectionVariables.get('bookingId')\r\n    );\r\n\r\n    pm.expect(\r\n        Number.isInteger(ownBookingId) && ownBookingId > 0,\r\n        'Run Create Booking successfully before these searches'\r\n    ).to.equal(true);\r\n\r\n    const bookings = pm.response.json();\r\n    const ids = bookings.map(function (booking) {\r\n        return booking.bookingid;\r\n    });\r\n\r\n    pm.expect(ids).to.include(ownBookingId);\r\n});"
            ]
          }
        }
      ]
    },
